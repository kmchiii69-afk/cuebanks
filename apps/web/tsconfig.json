{
  "extends": "@cuebanks/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "incremental": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "convex/_generated"]
}
