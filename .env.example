# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=
AUTH_BOOTSTRAP_SECRET=
CONVEX_SITE_URL=

# Legacy session (kept during the migration window)
JWT_SECRET=

# Invite-only signup: /sign-up?invite=<this value>
# Leave empty to disable the page (it 404s). Never prefix with NEXT_PUBLIC_.
SIGNUP_INVITE_KEY=

# LLM (MiniMax)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.5-highspeed

# Whop
NEXT_PUBLIC_WHOP_GLOBAL_URL=

# Supabase (legacy bcrypt login fallback + optional backfill)
# Also set these on the Convex deployment — login checks live wsa_members
# when Convex Auth has no account yet.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Anthropic is no longer used. Existing ANTHROPIC_API_KEY can be removed after deploy.
